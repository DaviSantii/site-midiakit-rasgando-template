{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/components/ui/creator-portfolio": ["src/components/ui/creator-portfolio/creator-portfolio.tsx"],
      "@client": ["clients/demo/config.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "clients"]
}
